version: 2

models:
  # --- TABELA FATO ---
  - name: fct_sales
    description: "Tabela de fatos de vendas na camada de marts."
    columns:
      - name: sales_order_detail_id
        description: "Chave primária do item de detalhe da venda."
        tests:
          - unique
          - not_null
      - name: sales_order_id
        description: "Identificador do cabeçalho da ordem de venda."
        tests:
          - not_null

  # --- DIMENSÕES COM COLUNAS VÁLIDAS ---
  - name: dim_person_countryregion
    description: "Dimensão de países e regiões."
    columns:
      - name: country_region_code
        tests:
          - unique
             

  - name: dim_person_address
    description: "Dimensão de endereços."
    columns:
      - name: address_id
        tests:
          - unique
          - not_null

  - name: dim_person_person
    description: "Dimensão de cadastro de pessoas."
    columns:
      - name: full_name
        tests:
          - not_null

  - name: dim_person_stateprovince
    description: "Dimensão de estados e províncias."
    columns:
      - name: state_province_id
        tests:
          - unique
          - not_null

  - name: dim_sales_customer
    description: "Dimensão de clientes."
    columns:
      - name: customer_id
        tests:
          - unique
          - not_null